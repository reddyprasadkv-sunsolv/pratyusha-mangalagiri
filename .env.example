# Public, non-secret Angular SSR configuration.
# Copy this file to .env for local tooling only; deployment values belong in the host environment.
PUBLIC_SITE_URL=
PUBLIC_INDEXING_ENABLED=
NG_ALLOWED_HOSTS=

# Optional public Supabase browser configuration. Keep disabled until the CMS is approved.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_ENABLED=false

# Supabase CLI/CI only. Never expose these to the Angular browser bundle.
SUPABASE_PROJECT_ID=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
