{
  "name": "pratyusha-mangalagiri",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.18.1",
    "npm": ">=11.6.0 <13"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "lint": "ng lint",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test": "ng test --watch=false",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "serve:ssr": "node dist/pratyusha-mangalagiri/server/server.mjs"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.2",
    "@supabase/supabase-js": "2.110.8",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.1",
    "@types/node": "^24.0.0",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.8.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
